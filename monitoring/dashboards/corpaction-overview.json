{
  "dashboard": {
    "title": "CorpAction Engine Overview",
    "description": "Real-time monitoring dashboard for CorpAction Engine",
    "panels": [
      {
        "title": "Events Ingested (Rate)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(corpaction_events_ingested_total[5m])" }
        ]
      },
      {
        "title": "Events by Source",
        "type": "piechart",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "corpaction_events_ingested_total" }
        ]
      },
      {
        "title": "Classification Confidence Distribution",
        "type": "bargauge",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "corpaction_classified_events_total" }
        ]
      },
      {
        "title": "On-Chain Execution Latency",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "histogram_quantile(0.95, corpaction_execution_latency_seconds_bucket)" }
        ]
      },
      {
        "title": "Validator Health",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "corpaction_validators_online" }
        ]
      },
      {
        "title": "TX Failure Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(corpaction_tx_failures_total[5m])" }
        ]
      }
    ]
  }
}
